# Copy to .env (same directory as docker-compose.yml) — Compose loads it
# automatically and substitutes ${NEXT_PUBLIC_POCKETBASE_URL} above.
#
# Local Docker Compose testing (both containers on this machine):
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8095

# VPS deploy — must be the public HTTPS URL served by the host Nginx in
# front of the PocketBase container, since browser-side auth calls it
# directly (see deploy/nginx-kabatufarm-pb.conf):
# NEXT_PUBLIC_POCKETBASE_URL=https://pb.kabatufarm.duckdns.org

# Server-side calls (Server Components, Server Actions, proxy.ts) use this
# instead — set directly in docker-compose.yml's `environment:` block, not
# here, since it never needs to change between local/VPS: it's always the
# Compose service name on the internal kabatu-net bridge network, same in
# both environments. Listed here only for reference / non-Docker dev:
# POCKETBASE_INTERNAL_URL=http://pocketbase:8090

# --- Host ports -------------------------------------------------------
# /home/Docker will run containers for several projects on the same
# machine. Host-side ports are the one thing genuinely shared across all
# of them (container-internal ports are isolated per bridge network and
# can't collide). Keep a running registry here as you add projects:
#
#   3000, 8095  → kabatu-farm      (this project)
#   8090        → tournament app   (existing, non-Docker systemd service)
#
# Before adding a new project's compose file, check what's already bound:
#   docker ps --format '{{.Names}}\t{{.Ports}}'
#   ss -tlnp | grep LISTEN
KABATU_WEB_HOST_PORT=3000
KABATU_PB_HOST_PORT=8095
