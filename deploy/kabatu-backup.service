# /etc/systemd/system/kabatu-backup.service
#
# Install alongside kabatu-backup.timer:
#   sudo cp kabatu-backup.service kabatu-backup.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kabatu-backup.timer
#
# Check status / logs:
#   systemctl list-timers kabatu-backup.timer
#   journalctl -u kabatu-backup.service
#
# PATH FIX (this update): ExecStart previously pointed at
# /opt/kabatu-farm/deploy/kabatu-backup.sh, a path that doesn't match the
# Docker Compose deployment's actual project location
# (/home/Docker/kabatu-farm — see README.md and kabatu-backup.sh's own
# comments). Corrected below. User=kabatu is UNVERIFIED — confirm this
# matches whichever Linux account actually owns/runs `docker compose` on the
# VPS (it needs read access to /home/Docker/kabatu-farm/pb_data); change it
# if it doesn't.

[Unit]
Description=Kabatu Farm - daily PocketBase backup to Google Drive

[Service]
Type=oneshot
User=kabatu
ExecStart=/home/Docker/kabatu-farm/deploy/kabatu-backup.sh
