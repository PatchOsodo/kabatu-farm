# Copy this file to .env.local (Fedora dev) and fill in the PocketBase URL.
# .env.local is gitignored — never commit real values.

# Local dev (PocketBase running on your Fedora machine):
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Once deployed, the Ubuntu VPS build uses its own .env.local instead, e.g.:
# NEXT_PUBLIC_POCKETBASE_URL=https://pb.kabatufarm.example.com  # served via reverse proxy in front of 127.0.0.1:8091
